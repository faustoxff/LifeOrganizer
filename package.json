    "@radix-ui/react-slot": "^1.2.4",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "groq-sdk": "^1.2.1",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.13.0",
    "motion": "^12.38.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.5.0",
    "unpdf": "^1.8.1"
