  "private": true,
  "scripts": {
    "predev": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "next dev --turbopack",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "check:release": "node scripts/check-release.ts",
    "eval:milo": "node scripts/eval-milo.mjs",
    "eval:projects": "node scripts/eval-projects.mjs",
    "deploy:env": "bash scripts/deploy-env.sh"
  },
