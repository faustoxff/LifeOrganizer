# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Neon Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AI — cadena de providers
#
# El orden por defecto es groq,ollama. Un provider sin key se saltea solo, asi
# que con solo GROQ_API_KEY la app funciona igual.
#
# Groq es rapido y gratis mientras dure la cuota diaria (200k tokens/dia/modelo
# para toda la cuenta, unos 130 turnos de chat). Cuando se agota, la cadena pasa
# al siguiente provider en vez de dejar a todos los usuarios sin respuesta.
#   --provider groq  ->  npm run eval:milo -- --provider groq
AI_PROVIDER_ORDER=groq,ollama
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
# Todo lo que corre en tier "fast" (resumen de memoria, blurb de stats, pasos
# de tarea, companion). Si falta, cae en GROQ_MODEL — que es el modelo "normal",
# no el rapido, y nadie se da cuenta.
GROQ_FAST_MODEL=qwen/qwen3.8-27b
GROQ_PRO_MODEL=openai/gpt-oss-120b
# Modelo para dividir un proyecto en subtareas (tier "planner"). Si falta, usa
# GROQ_PRO_MODEL. Dividir bien un proyecto grande pide mas capacidad que el chat.
# GROQ_PLANNER_MODEL=openai/gpt-oss-120b
# Sin uso en el codigo: queda documentado para que no parezca que falta.
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Ollama Cloud — sin techo diario, pago por token. Corre el mismo gpt-oss:120b.
# La key se saca de https://ollama.com/settings/keys (requiere cuenta; el plan
# Pro de $20/mes agrega credits, no hace falta para arrancar).
OLLAMA_API_KEY=your_ollama_api_key
# Si hace falta apuntar a otro host (self-hosted, proxy), si no se omite y usa
# https://ollama.com/v1
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_PRO_MODEL=gpt-oss:120b
OLLAMA_FAST_MODEL=gpt-oss:20b
# Igual que GROQ_PLANNER_MODEL: si falta, usa OLLAMA_PRO_MODEL.
# OLLAMA_PLANNER_MODEL=gpt-oss:120b

TAVILY_API_KEY=your_tavily_api_key

# Lemon Squeezy — Settings -> API / Settings -> Webhooks / Settings -> Store
# El checkout es una pagina alojada (redirect), asi que no hay script de terceros
# en el browser ni frame en el CSP.
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key
# Firma HMAC-SHA256 del body crudo. Sin ella el webhook responde 503 en prod:
# el pago se cobra y el plan nunca se activa.
LEMONSQUEEZY_WEBHOOK_SECRET=whsec_...
# Dominio de la tienda (sin https://) y variantes de Plus/Pro.
# Lemon Squeezy identifica cada variante de dos formas y hacen falta las dos:
# el checkout se direcciona por SLUG (/checkout/buy/<slug> responde 302; con el
# id numerico responde 404) y el webhook llega con variant_id numerico.
LEMONSQUEEZY_STORE_DOMAIN=your-store.lemonsqueezy.com
LEMONSQUEEZY_CHECKOUT_SLUG_PLUS=
LEMONSQUEEZY_CHECKOUT_SLUG_PRO=
LEMONSQUEEZY_VARIANT_PLUS=
LEMONSQUEEZY_VARIANT_PRO=

# Site / redirects (use your real domain in production)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Milo llama tools (create_items, plan_week, ...). Si un modelo las rompe, estas variables
# mandan el chat al camino de texto (bloque TASKS_ACTION) sin tocar código.
# Groq: "off" las apaga. Ollama: se activan solas con modelos gpt-oss; "on" las fuerza
# para otro modelo y "off" las apaga.
# GROQ_TOOLS=off
# OLLAMA_TOOLS=on
